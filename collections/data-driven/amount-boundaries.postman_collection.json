{
	"info": {
		"_postman_id": "834fae22-072f-5b41-a873-3f5442256775",
		"name": "Data-driven - Amount boundaries",
		"description": "Deposit amounts at and around the limits, one per row of data/amount-boundaries.json:\nzero, negative, fractions of a centavo, wrong types, the smallest valid amount (0.01) and one\ncentavo over the 10,000.00 limit.\n\nDATA-DRIVEN: run this collection with a data file. Each row of the file is one test case.\n- Postman: Collection Runner > choose this collection > Select File > data/amount-boundaries.json > Run.\n- Newman: npx newman run <this file> -e environments/staging.postman_environment.json -d data/amount-boundaries.json\n  (or simply npm test, which does this for you).\nA single Send in Postman has no data row, so its checks do not apply.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Find the test customer's accounts",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status is 200 OK', () => {",
							"  pm.response.to.have.status(200);",
							"});",
							"",
							"const accounts = pm.response.json().data;",
							"const checking = accounts.find((account) => account.type === 'CHECKING' && account.status === 'ACTIVE');",
							"const savings = accounts.find((account) => account.type === 'SAVINGS' && account.status === 'ACTIVE');",
							"pm.collectionVariables.set('checkingId', checking.id);",
							"pm.collectionVariables.set('checkingNumber', checking.accountNumber);",
							"pm.collectionVariables.set('savingsNumber', savings.accountNumber);"
						]
					}
				}
			],
			"protocolProfileBehavior": {
				"disableCookies": true
			},
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token_banking}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/bank/accounts",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"bank",
						"accounts"
					]
				},
				"description": "Saves the checking and savings account ids and numbers for the data-driven request that follows."
			},
			"response": []
		},
		{
			"name": "Deposit - {{case}}",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const row = pm.iterationData.toObject();",
							"// JSON.stringify keeps the type from the data file: 10.5 stays a number, \"500\" stays text.",
							"pm.variables.set('amountJson', JSON.stringify(row.amountCents));",
							"pm.variables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const row = pm.iterationData.toObject();",
							"",
							"pm.test(`[${row.case}] status is ${row.expectedStatus}`, () => {",
							"  pm.response.to.have.status(row.expectedStatus);",
							"});",
							"",
							"if (row.expectedCode) {",
							"  pm.test(`[${row.case}] error code is ${row.expectedCode}`, () => {",
							"    pm.expect(pm.response.json().error.code).to.eql(row.expectedCode);",
							"  });",
							"}",
							"",
							"if (row.expectedField) {",
							"  pm.test(`[${row.case}] the error names the field ${row.expectedField}`, () => {",
							"    const details = pm.response.json().error.details || [];",
							"    const detail = details.find((item) => item.field === row.expectedField);",
							"    pm.expect(detail, `a field error for ${row.expectedField}`).to.exist;",
							"    if (row.expectedMessage) pm.expect(detail.message).to.eql(row.expectedMessage);",
							"  });",
							"} else if (row.expectedMessage) {",
							"  pm.test(`[${row.case}] the message is \"${row.expectedMessage}\"`, () => {",
							"    pm.expect(pm.response.json().error.message).to.eql(row.expectedMessage);",
							"  });",
							"}"
						]
					}
				}
			],
			"protocolProfileBehavior": {
				"disableCookies": true
			},
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token_banking}}"
					},
					{
						"key": "Idempotency-Key",
						"value": "{{idempotencyKey}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/bank/deposits",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"bank",
						"deposits"
					]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n  \"accountId\": \"{{checkingId}}\",\n  \"amountCents\": {{amountJson}},\n  \"description\": \"Newman amount boundary\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"description": "Sends the amount from the data row exactly as written (number, text or null)."
			},
			"response": []
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"/*",
					" * DYNAMIC TOKEN HANDLING (runs before every request in this collection)",
					" *",
					" * A request that needs a session sends the header",
					" *     Authorization: Bearer {{token_<module>}}",
					" * where <module> is ecommerce, banking, travel or admin. Each sign-in opens one module, so",
					" * there is one token per module.",
					" *",
					" * This script looks at that header. If the token for that module is missing, or expires within",
					" * a minute, it signs in first with pm.sendRequest, using the credentials from the environment",
					" * (testUsername/testPassword, or adminUsername/adminPassword for admin), and saves the token",
					" * and its expiry time as collection variables. Postman waits for the sign-in to finish before",
					" * it sends the request itself.",
					" *",
					" * Why tokens can stop working, and how this script copes:",
					" * The app also sets a session cookie at every sign-in, and a sign-in that sends an older session's",
					" * cookie ends that older session (one browser, one session). Requests here have Settings >",
					" * \"Disable cookie jar\" on, but pm.sendRequest still uses the cookie jar. So:",
					" *  - after each automatic sign-in the script tries to clear that cookie (Postman needs the API",
					" *    domain on Cookies > Domains Allowlist for this; Newman does not);",
					" *  - when it signs in to a different module, it forgets the previous automatic sign-in's token,",
					" *    in case that sign-in ended it, so the next request for that module signs in again;",
					" *  - the collection's Post-response script forgets any module token the API refuses with 401.",
					" */",
					"const header = pm.request.headers.get('Authorization') || '';",
					"const wanted = header.match(/\\{\\{token_(ecommerce|banking|travel|admin)\\}\\}/);",
					"",
					"if (wanted) {",
					"  const module = wanted[1];",
					"  const tokenKey = `token_${module}`;",
					"  const expiresKey = `token_${module}_expires`;",
					"  const expiresAt = Number(pm.collectionVariables.get(expiresKey) || 0);",
					"  const stillValid = pm.collectionVariables.get(tokenKey) && Date.now() < expiresAt - 60 * 1000;",
					"",
					"  if (!stillValid) {",
					"    const admin = module === 'admin';",
					"    const email = pm.environment.get(admin ? 'adminUsername' : 'testUsername');",
					"    const password = pm.environment.get(admin ? 'adminPassword' : 'testPassword');",
					"    if (!email || !password) {",
					"      throw new Error(",
					"        `Set ${admin ? 'adminUsername and adminPassword' : 'testUsername and testPassword'} in the selected environment (Current value).`,",
					"      );",
					"    }",
					"",
					"    pm.sendRequest(",
					"      {",
					"        url: `${pm.environment.get('baseUrl')}/auth/login`,",
					"        method: 'POST',",
					"        header: { 'Content-Type': 'application/json' },",
					"        body: { mode: 'raw', raw: JSON.stringify({ email, password, module }) },",
					"      },",
					"      (error, response) => {",
					"        if (error || response.code !== 200) {",
					"          throw new Error(`Automatic sign-in to ${module} failed: ${error ? error.message : `${response.code} ${response.text()}`}`);",
					"        }",
					"        const { token, expiresIn } = response.json().data;",
					"        pm.collectionVariables.set(tokenKey, token);",
					"        pm.collectionVariables.set(expiresKey, String(Date.now() + expiresIn * 1000));",
					"",
					"        // This sign-in may have sent the previous automatic sign-in's cookie and so ended that",
					"        // session. Forget that token; the next request that needs it signs in again.",
					"        const previous = pm.collectionVariables.get('token_last_signin');",
					"        if (previous && previous !== module) {",
					"          pm.collectionVariables.set(`token_${previous}`, '');",
					"          pm.collectionVariables.set(`token_${previous}_expires`, '');",
					"        }",
					"        pm.collectionVariables.set('token_last_signin', module);",
					"",
					"        // Best effort: remove the session cookie this sign-in received, so it is not sent later.",
					"        pm.cookies.jar().clear(pm.environment.get('baseUrl'), (clearError) => {",
					"          if (clearError) {",
					"            console.info(",
					"              'Tip: add the API domain (for example quality-lab-jb.vercel.app) to Cookies > Domains Allowlist ' +",
					"                'to save a few extra sign-ins. The tests work without it.',",
					"            );",
					"          }",
					"        });",
					"      },",
					"    );",
					"  }",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"/*",
					" * CHECKS FOR EVERY RESPONSE (run after every request in this collection)",
					" * Each request's own Tests tab adds the checks for that request.",
					" */",
					"pm.test('[every response] no server error (status below 500)', () => {",
					"  pm.expect(pm.response.code).to.be.below(500);",
					"});",
					"",
					"pm.test('[every response] answered within 20 seconds', () => {",
					"  pm.expect(pm.response.responseTime).to.be.below(20000);",
					"});",
					"",
					"pm.test('[every response] carries an x-request-id header', () => {",
					"  pm.response.to.have.header('x-request-id');",
					"});",
					"",
					"if (pm.response.code !== 204) {",
					"  pm.test('[every response] body is JSON', () => {",
					"    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
					"  });",
					"}",
					"",
					"// Every error uses the same shape: { error: { code, message, details?, requestId } }.",
					"if (pm.response.code >= 400) {",
					"  pm.test('[every response] error body matches the ErrorResponse schema', () => {",
					"    const schemas = JSON.parse(pm.collectionVariables.get('schemas'));",
					"    pm.response.to.have.jsonSchema(schemas.ErrorResponse);",
					"  });",
					"}",
					"",
					"// SELF-HEALING TOKENS",
					"// A module token the API refused (401) is forgotten, so the next request signs in again.",
					"const sentAuth = pm.request.headers.get('Authorization') || '';",
					"if (pm.response.code === 401) {",
					"  for (const module of ['ecommerce', 'banking', 'travel', 'admin']) {",
					"    const token = pm.collectionVariables.get(`token_${module}`);",
					"    if (sentAuth.includes(`{{token_${module}}}`) || (token && sentAuth.includes(token))) {",
					"      pm.collectionVariables.set(`token_${module}`, '');",
					"      pm.collectionVariables.set(`token_${module}_expires`, '');",
					"      console.warn(`The ${module} token was refused; the next request will sign in again.`);",
					"    }",
					"  }",
					"}",
					"// A sign-in request in this collection may have sent the last automatic session's cookie and ended",
					"// it, so that token is forgotten too.",
					"if (pm.request.method === 'POST' && pm.request.url.getPath().endsWith('/auth/login')) {",
					"  const last = pm.collectionVariables.get('token_last_signin');",
					"  if (last) {",
					"    pm.collectionVariables.set(`token_${last}`, '');",
					"    pm.collectionVariables.set(`token_${last}_expires`, '');",
					"    pm.collectionVariables.set('token_last_signin', '');",
					"  }",
					"}"
				]
			}
		}
	],
	"protocolProfileBehavior": {
		"disableCookies": true
	},
	"variable": [
		{
			"key": "schemas",
			"value": "{\"User_one\":{\"type\":\"object\",\"required\":[\"data\"],\"properties\":{\"data\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"},\"firstName\":{\"type\":\"string\"},\"lastName\":{\"type\":\"string\"},\"role\":{\"type\":\"string\",\"enum\":[\"CUSTOMER\",\"ADMIN\"]},\"status\":{\"type\":\"string\",\"enum\":[\"ACTIVE\",\"DISABLED\"]},\"createdAt\":{\"type\":\"string\",\"format\":\"date-time\"}},\"required\":[\"id\",\"email\",\"firstName\",\"lastName\",\"role\",\"status\",\"createdAt\"]}}},\"LoginResult_one\":{\"type\":\"object\",\"required\":[\"data\"],\"properties\":{\"data\":{\"type\":\"object\",\"properties\":{\"token\":{\"type\":\"string\"},\"tokenType\":{\"type\":\"string\"},\"expiresIn\":{\"type\":\"integer\"},\"module\":{\"type\":\"string\",\"enum\":[\"ecommerce\",\"banking\",\"travel\",\"admin\"]},\"user\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"},\"firstName\":{\"type\":\"string\"},\"lastName\":{\"type\":\"string\"},\"role\":{\"type\":\"string\",\"enum\":[\"CUSTOMER\",\"ADMIN\"]},\"status\":{\"type\":\"string\",\"enum\":[\"ACTIVE\",\"DISABLED\"]},\"createdAt\":{\"type\":\"string\",\"format\":\"date-time\"}},\"required\":[\"id\",\"email\",\"firstName\",\"lastName\",\"role\",\"status\",\"createdAt\"]}},\"required\":[\"token\",\"tokenType\",\"expiresIn\",\"module\",\"user\"]}}},\"Product_one\":{\"type\":\"object\",\"required\":[\"data\"],\"properties\":{\"data\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"sku\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"category\":{\"type\":\"string\"},\"brand\":{\"type\":\"string\"},\"priceCents\":{\"type\":\"integer\"},\"listPriceCents\":{\"type\":[\"integer\",\"null\"]},\"onSale\":{\"type\":\"boolean\"},\"discountPercent\":{\"type\":[\"integer\",\"null\"]},\"stock\":{\"type\":\"integer\"},\"inStock\":{\"type\":\"boolean\"},\"rating\":{\"type\":\"number\"},\"imageUrl\":{\"type\":[\"string\",\"null\"]},\"isActive\":{\"type\":\"boolean\"},\"createdAt\":{\"type\":\"string\",\"format\":\"date-time\"},\"updatedAt\":{\"type\":\"string\",\"format\":\"date-time\"}},\"required\":[\"id\",\"sku\",\"name\",\"description\",\"category\",\"brand\",\"priceCents\",\"listPriceCents\",\"onSale\",\"discountPercent\",\"stock\",\"inStock\",\"rating\",\"imageUrl\",\"isActive\",\"createdAt\",\"updatedAt\"]}}},\"Product_page\":{\"type\":\"object\",\"required\":[\"data\",\"meta\"],\"properties\":{\"data\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"sku\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"category\":{\"type\":\"string\"},\"brand\":{\"type\":\"string\"},\"priceCents\":{\"type\":\"integer\"},\"listPriceCents\":{\"type\":[\"integer\",\"null\"]},\"onSale\":{\"type\":\"boolean\"},\"discountPercent\":{\"type\":[\"integer\",\"null\"]},\"stock\":{\"type\":\"integer\"},\"inStock\":{\"type\":\"boolean\"},\"rating\":{\"type\":\"number\"},\"imageUrl\":{\"type\":[\"string\",\"null\"]},\"isActive\":{\"type\":\"boolean\"},\"createdAt\":{\"type\":\"string\",\"format\":\"date-time\"},\"updatedAt\":{\"type\":\"string\",\"format\":\"date-time\"}},\"required\":[\"id\",\"sku\",\"name\",\"description\",\"category\",\"brand\",\"priceCents\",\"listPriceCents\",\"onSale\",\"discountPercent\",\"stock\",\"inStock\",\"rating\",\"imageUrl\",\"isActive\",\"createdAt\",\"updatedAt\"]}},\"meta\":{\"type\":\"object\",\"properties\":{\"page\":{\"type\":\"integer\"},\"pageSize\":{\"type\":\"integer\"},\"totalItems\":{\"type\":\"integer\"},\"totalPages\":{\"type\":\"integer\"},\"hasNext\":{\"type\":\"boolean\"},\"hasPrevious\":{\"type\":\"boolean\"}},\"required\":[\"page\",\"pageSize\",\"totalItems\",\"totalPages\",\"hasNext\",\"hasPrevious\"]}}},\"Cart_one\":{\"type\":\"object\",\"required\":[\"data\"],\"properties\":{\"data\":{\"type\":\"object\