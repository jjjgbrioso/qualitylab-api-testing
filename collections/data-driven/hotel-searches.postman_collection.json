{
	"info": {
		"_postman_id": "39433510-a93c-5bae-a456-598289083ab3",
		"name": "Data-driven - Hotel searches",
		"description": "Hotel searches, one per row of data/hotel-searches.json. Each row gives the query and what every\nresult must match (city, minimum stars, amenity), or the expected validation error.\n\nDATA-DRIVEN: run this collection with a data file. Each row of the file is one test case.\n- Postman: Collection Runner > choose this collection > Select File > data/hotel-searches.json > Run.\n- Newman: npx newman run <this file> -e environments/staging.postman_environment.json -d data/hotel-searches.json\n  (or simply npm test, which does this for you).\nA single Send in Postman has no data row, so its checks do not apply.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Hotels - {{case}}",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const row = pm.iterationData.toObject();",
							"for (const [key, value] of Object.entries(row.query || {})) {",
							"  pm.request.url.addQueryParams([{ key, value: String(value) }]);",
							"}"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const row = pm.iterationData.toObject();",
							"",
							"pm.test(`[${row.case}] status is ${row.expectedStatus}`, () => {",
							"  pm.response.to.have.status(row.expectedStatus);",
							"});",
							"",
							"if (row.expectedStatus === 200) {",
							"  const hotels = pm.response.json().data;",
							"",
							"  pm.test(`[${row.case}] ${row.minResults} to ${row.maxResults ?? 'any'} hotels`, () => {",
							"    pm.expect(hotels.length).to.be.at.least(row.minResults);",
							"    if (row.maxResults !== undefined && row.maxResults !== null) pm.expect(hotels.length).to.be.at.most(row.maxResults);",
							"  });",
							"",
							"  pm.test(`[${row.case}] every hotel matches the search`, () => {",
							"    for (const hotel of hotels) {",
							"      if (row.city) pm.expect(hotel.city, hotel.name).to.eql(row.city);",
							"      if (row.minStars) pm.expect(hotel.starRating, hotel.name).to.be.at.least(row.minStars);",
							"      if (row.amenity) pm.expect(hotel.amenities, hotel.name).to.include(row.amenity);",
							"    }",
							"  });",
							"} else {",
							"  pm.test(`[${row.case}] VALIDATION_ERROR on ${row.expectedField}`, () => {",
							"    const error = pm.response.json().error;",
							"    pm.expect(error.code).to.eql('VALIDATION_ERROR');",
							"    pm.expect(error.details.map((detail) => detail.field)).to.include(row.expectedField);",
							"  });",
							"}"
						]
					}
				}
			],
			"protocolProfileBehavior": {
				"disableCookies": true
			},
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/hotels",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"hotels"
					]
				},
				"description": "Adds the query parameters from the data row, then checks the results against the row."
			},
			"response": []
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"/*",
					" * DYNAMIC TOKEN HANDLING (runs before every request in this collection)",
					" *",
					" * A request that needs a session sends the header",
					" *     Authorization: Bearer {{token_<module>}}",
					" * where <module> is ecommerce, banking, travel or admin. Each sign-in opens one module, so",
					" * there is one token per module.",
					" *",
					" * This script looks at that header. If the token for that module is missing, or expires within",
					" * a minute, it signs in first with pm.sendRequest, using the credentials from the environment",
					" * (testUsername/testPassword, or adminUsername/adminPassword for admin), and saves the token",
					" * and its expiry time as collection variables. Postman waits for the sign-in to finish before",
					" * it sends the request itself.",
					" *",
					" * Requests in this collection have Settings > \"Disable cookie jar\" on, so they authenticate with",
					" * the Bearer token only. pm.sendRequest still uses the cookie jar, so after each sign-in this",
					" * script clears the session cookie it received.",
					" */",
					"const header = pm.request.headers.get('Authorization') || '';",
					"const wanted = header.match(/\\{\\{token_(ecommerce|banking|travel|admin)\\}\\}/);",
					"",
					"if (wanted) {",
					"  const module = wanted[1];",
					"  const tokenKey = `token_${module}`;",
					"  const expiresKey = `token_${module}_expires`;",
					"  const expiresAt = Number(pm.collectionVariables.get(expiresKey) || 0);",
					"  const stillValid = pm.collectionVariables.get(tokenKey) && Date.now() < expiresAt - 60 * 1000;",
					"",
					"  if (!stillValid) {",
					"    const admin = module === 'admin';",
					"    const email = pm.environment.get(admin ? 'adminUsername' : 'testUsername');",
					"    const password = pm.environment.get(admin ? 'adminPassword' : 'testPassword');",
					"    if (!email || !password) {",
					"      throw new Error(",
					"        `Set ${admin ? 'adminUsername and adminPassword' : 'testUsername and testPassword'} in the selected environment (Current value).`,",
					"      );",
					"    }",
					"",
					"    pm.sendRequest(",
					"      {",
					"        url: `${pm.environment.get('baseUrl')}/auth/login`,",
					"        method: 'POST',",
					"        header: { 'Content-Type': 'application/json' },",
					"        body: { mode: 'raw', raw: JSON.stringify({ email, password, module }) },",
					"      },",
					"      (error, response) => {",
					"        if (error || response.code !== 200) {",
					"          throw new Error(`Automatic sign-in to ${module} failed: ${error ? error.message : `${response.code} ${response.text()}`}`);",
					"        }",
					"        const { token, expiresIn } = response.json().data;",
					"        pm.collectionVariables.set(tokenKey, token);",
					"        pm.collectionVariables.set(expiresKey, String(Date.now() + expiresIn * 1000));",
					"",
					"        // The sign-in also stored the app's session cookie. If it stayed, the next automatic",
					"        // sign-in would send it, and the app would end that session (and so this token).",
					"        pm.cookies.jar().clear(pm.environment.get('baseUrl'), (clearError) => {",
					"          if (clearError) {",
					"            console.warn(",
					"              'Could not clear the session cookie. In Postman, open Cookies > Domains Allowlist and add the API domain ' +",
					"                '(for example quality-lab-jb.vercel.app), or tokens of other modules may stop working.',",
					"            );",
					"          }",
					"        });",
					"      },",
					"    );",
					"  }",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"/*",
					" * CHECKS FOR EVERY RESPONSE (run after every request in this collection)",
					" * Each request's own Tests tab adds the checks for that request.",
					" */",
					"pm.test('[every response] no server error (status below 500)', () => {",
					"  pm.expect(pm.response.code).to.be.below(500);",
					"});",
					"",
					"pm.test('[every response] answered within 20 seconds', () => {",
					"  pm.expect(pm.response.responseTime).to.be.below(20000);",
					"});",
					"",
					"pm.test('[every response] carries an x-request-id header', () => {",
					"  pm.response.to.have.header('x-request-id');",
					"});",
					"",
					"if (pm.response.code !== 204) {",
					"  pm.test('[every response] body is JSON', () => {",
					"    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
					"  });",
					"}",
					"",
					"// Every error uses the same shape: { error: { code, message, details?, requestId } }.",
					"if (pm.response.code >= 400) {",
					"  pm.test('[every response] error body matches the ErrorResponse schema', () => {",
					"    const schemas = JSON.parse(pm.collectionVariables.get('schemas'));",
					"    pm.response.to.have.jsonSchema(schemas.ErrorResponse);",
					"  });",
					"}"
				]
			}
		}
	],
	"protocolProfileBehavior": {
		"disableCookies": true
	},
