# Copy this file to .env and fill it in. .env is git-ignored.
# Real environment variables take priority over this file.

# staging (the deployed site, default) or local (http://localhost:3100)
TEST_ENV=staging

# Optional: test a different address. Default: the environment file's baseUrl.
# API_BASE_URL=https://quality-lab-jb.vercel.app/api/v1

# Required: the seeded banking customer (Alice) and the seeded admin
TEST_USERNAME=
TEST_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Open the summary page (reports/index.html) in Chrome after a run: always, on-failure, or never
# OPEN_REPORT=always
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
